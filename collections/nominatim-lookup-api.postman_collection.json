  "item": [
    {
      "id": "51e84661-4958-438d-b0ab-83502b74a9de",
      "name": "Lookup",
      "description": {
        "content": "Look up address details for OSM objects by their OSM ID.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "86b9ef82-2955-4c47-8023-38bbde3104bf",
          "name": "Look Up Address Details For OSM Objects",
          "request": {
            "name": "Look Up Address Details For OSM Objects",
            "description": {
              "content": "Look up address details for one or more OSM objects identified by their\nOSM type and ID. Up to 50 IDs may be passed per request.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "lookup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "osm_ids",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of OSM IDs each prefixed with type\n(N=node, W=way, R=relation). Maximum 50 IDs per request.\n"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "jsonv2",
                  "description": "Output format."
                },
                {
                  "disabled": false,
                  "key": "json_callback",
                  "value": "<string>",
                  "description": "Wrap JSON output in a JSONP callback."
                },
                {
                  "disabled": false,
                  "key": "addressdetails",
                  "value": "0",
                  "description": "Include a breakdown of the address into elements."
                },
                {
                  "disabled": false,
                  "key": "extratags",
                  "value": "0",
                  "description": "Include additional information (Wikipedia link, opening hours, etc.)."
                },
                {
                  "disabled": false,
                  "key": "namedetails",
                  "value": "0",
                  "description": "Include a full list of names for the result."
                },
                {
                  "disabled": false,
                  "key": "accept-language",
                  "value": "<string>",
                  "description": "Preferred language order for showing search results, in browser-style\nformat (e.g. `en-US,en;q=0.5`). Overrides the HTTP Accept-Language\nheader.\n"
                },
                {
                  "disabled": false,
                  "key": "polygon_geojson",
                  "value": "0",
                  "description": "Output geometry as GeoJSON."
                },
                {
                  "disabled": false,
                  "key": "polygon_kml",
                  "value": "0",
                  "description": "Output geometry as KML."
                },
                {
                  "disabled": false,
                  "key": "polygon_svg",
                  "value": "0",
                  "description": "Output geometry as SVG."
                },
                {
                  "disabled": false,
                  "key": "polygon_text",
                  "value": "0",
                  "description": "Output geometry as WKT."
                },
                {
                  "disabled": false,
                  "key": "polygon_threshold",
                  "value": "0",
                  "description": "Simplification tolerance for polygon output, in degrees."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "Email address identifying you when making high-volume requests. Required\nby the OSMF usage policy at sustained traffic levels.\n"
                },
                {
                  "disabled": false,
                  "key": "debug",
                  "value": "0",
                  "description": "Return verbose HTML output containing internal debugging information."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
