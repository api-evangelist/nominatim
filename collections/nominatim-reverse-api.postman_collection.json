{
  "item": [
    {
      "id": "0e13c3a8-3172-44b1-9ceb-721a10f52d34",
      "name": "Reverse",
      "description": {
        "content": "Reverse geocoding — find the closest OSM object to a coordinate.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a933e34b-e4ec-4e8e-9ff4-bf8a5dbff4da",
          "name": "Reverse Geocode A Coordinate",
          "request": {
            "name": "Reverse Geocode A Coordinate",
            "description": {
              "content": "Find the closest OSM object to a latitude/longitude pair and return its\naddress information. The result is the closest suitable feature for the\nrequested zoom level rather than a literal address for the exact point.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reverse"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<double>",
                  "description": "(Required) Latitude of the coordinate to reverse geocode (WGS84)."
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<double>",
                  "description": "(Required) Longitude of the coordinate to reverse geocode (WGS84)."
                },
                {
                  "disabled": false,
                  "key": "zoom",
                  "value": "18",
                  "description": "Level of administrative detail required. 3=country, 5=state, 8=county,\n10=city, 12=town/borough, 13=village/suburb, 14=neighbourhood, 15=any\nsettlement, 16=major streets, 17=major and minor streets, 18=building.\n"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "jsonv2",
                  "description": "Output format."
                },
                {
                  "disabled": false,
                  "key": "json_callback",
                  "value": "<string>",
                  "description": "Wrap JSON output in a JSONP callback."
                },
                {
                  "disabled": false,
                  "key": "addressdetails",
                  "value": "0",
                  "description": "Include a breakdown of the address into elements."
                },
                {
                  "disabled": false,
                  "key": "extratags",
                  "value": "0",
                  "description": "Include additional information (Wikipedia link, opening hours, etc.)."
                },
                {
                  "disabled": false,
                  "key": "namedetails",
                  "value": "0",
                  "description": "Include a full list of names for the result."
                },
                {
                  "disabled": false,
                  "key": "accept-language",
                  "value": "<string>",
                  "description": "Preferred language order for showing search results, in browser-style\nformat (e.g. `en-US,en;q=0.5`). Overrides the HTTP Accept-Language\nheader.\n"
                },
                {
                  "disabled": false,
                  "key": "layer",
                  "value": "<string>",
                  "description": "Restrict results to one or more feature layers. Comma-separated list of\n`address`, `poi`, `railway`, `natural`, `manmade`.\n"
                },
                {
                  "disabled": false,
                  "key": "polygon_geojson",
                  "value": "0",
                  "description": "Output geometry as GeoJSON."
                },
                {
                  "disabled": false,
                  "key": "polygon_kml",
                  "value": "0",
                  "description": "Output geometry as KML."
                },
                {
                  "disabled": false,
                  "key": "polygon_svg",
                  "value": "0",
                  "description": "Output geometry as SVG."
                },
                {
                  "disabled": false,
                  "key": "polygon_text",
                  "value": "0",
                  "description": "Output geometry as WKT."
                },
                {
                  "disabled": false,
                  "key": "polygon_threshold",
                  "value": "0",
                  "description": "Simplification tolerance for polygon output, in degrees."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "Email address identifying you when making high-volume requests. Required\nby the OSMF usage policy at sustained traffic levels.\n"
                },
                {
                  "disabled": false,
                  "key": "debug",
                  "value": "0",
                  "description": "Return verbose HTML output containing internal debugging information."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
