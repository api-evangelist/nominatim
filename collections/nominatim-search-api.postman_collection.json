          "name": "Search OSM Objects By Name Or Address",
          "request": {
            "name": "Search OSM Objects By Name Or Address",
            "description": {
              "content": "Forward-geocode a free-form or structured query and return matching\nOSM objects. Use the free-form `q` parameter or one of the structured\nparameters (`amenity`, `street`, `city`, `county`, `state`, `country`,\n`postalcode`) — the two query styles cannot be combined.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Free-form query string. Cannot be combined with structured query parameters."
                },
                {
                  "disabled": false,
                  "key": "amenity",
                  "value": "<string>",
                  "description": "Name or type of point of interest."
                },
                {
                  "disabled": false,
                  "key": "street",
                  "value": "<string>",
                  "description": "House number and street name."
                },
                {
                  "disabled": false,
                  "key": "city",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "county",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "postalcode",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "jsonv2",
                  "description": "Output format."
                },
                {
                  "disabled": false,
                  "key": "json_callback",
                  "value": "<string>",
                  "description": "Wrap JSON output in a JSONP callback."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of returned results."
                },
                {
                  "disabled": false,
                  "key": "addressdetails",
                  "value": "0",
                  "description": "Include a breakdown of the address into elements."
                },
                {
                  "disabled": false,
                  "key": "extratags",
                  "value": "0",
                  "description": "Include additional information (Wikipedia link, opening hours, etc.)."
                },
                {
                  "disabled": false,
                  "key": "namedetails",
                  "value": "0",
                  "description": "Include a full list of names for the result."
                },
                {
                  "disabled": false,
                  "key": "accept-language",
                  "value": "<string>",
                  "description": "Preferred language order for showing search results, in browser-style\nformat (e.g. `en-US,en;q=0.5`). Overrides the HTTP Accept-Language\nheader.\n"
                },
                {
                  "disabled": false,
                  "key": "countrycodes",
                  "value": "<string>",
                  "description": "Comma-separated list of ISO 3166-1 alpha-2 country codes to limit results to."
                },
                {
                  "disabled": false,
                  "key": "exclude_place_ids",
                  "value": "<string>",
                  "description": "Comma-separated list of place IDs to exclude from the result set."
                },
                {
                  "disabled": false,
                  "key": "viewbox",
                  "value": "<string>",
                  "description": "Bounding box `x1,y1,x2,y2` (longitudes and latitudes) used to bias\nresults toward a geographic area.\n"
                },
                {
                  "disabled": false,
                  "key": "bounded",
                  "value": "0",
                  "description": "When set, restrict results strictly to the viewbox."
                },
                {
                  "disabled": false,
                  "key": "polygon_geojson",
                  "value": "0",
                  "description": "Output geometry as GeoJSON."
                },
                {
                  "disabled": false,
                  "key": "polygon_kml",
                  "value": "0",
                  "description": "Output geometry as KML."
                },
                {
                  "disabled": false,
                  "key": "polygon_svg",
                  "value": "0",
                  "description": "Output geometry as SVG."
                },
                {
                  "disabled": false,
                  "key": "polygon_text",
                  "value": "0",
                  "description": "Output geometry as WKT."
                },
                {
                  "disabled": false,
                  "key": "polygon_threshold",
                  "value": "0",
                  "description": "Simplification tolerance for polygon output, in degrees."
                },
                {
                  "disabled": false,
                  "key": "dedupe",
                  "value": "1",
                  "description": "Remove duplicate hits from the result set."
                },
                {
                  "disabled": false,
                  "key": "layer",
                  "value": "<string>",
                  "description": "Restrict results to one or more feature layers. Comma-separated list of\n`address`, `poi`, `railway`, `natural`, `manmade`.\n"
                },
                {
                  "disabled": false,
                  "key": "featureType",
                  "value": "<string>",
                  "description": "Restrict search results to a single feature type."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "Email address identifying you when making high-volume requests. Required\nby the OSMF usage policy at sustained traffic levels.\n"
                },
                {
                  "disabled": false,
                  "key": "debug",
                  "value": "0",
                  "description": "Return verbose HTML output containing internal debugging information."
                }
